RESEND_API_KEY=
EMAIL_FROM=Budget Bath Solutions <hello@yourdomain.com>
NOTIFY_EMAIL=
ADMIN_EMAILS=
SITE_URL=https://budgetbathsolutions.com
# DATA_DIR=/var/lib/budgetbath
# TRUST_PROXY=1

# Email replies: a domain/subdomain with Resend receiving enabled, and the signing secret of the email.received webhook
REPLY_DOMAIN=
RESEND_WEBHOOK_SECRET=

# Appointments: optional one-way sync to a Google Calendar. Share that calendar with the service account's client_email
# ("Make changes to events") and paste the service account key JSON on one line. BUSINESS_TIMEZONE formats times in emails.
GOOGLE_CALENDAR_ID=
GOOGLE_SERVICE_ACCOUNT_JSON=
BUSINESS_TIMEZONE=America/Chicago
# Set to 1 to log one line per request
LOG_REQUESTS=
